# Path to the live opencode SQLite database (READ-ONLY consumer).
OPENCODE_DB=/home/opencode/.local/share/opencode/opencode.db

# HTTP bind address for adapter-node (production `bun run start`).
HOST=127.0.0.1
PORT=3010

# Base URL used to resolve ziptask links from task references.
ZIPTASK_BASE_URL=http://127.0.0.1:3005

# Default for the ziptask integration feature toggle (soft default only: a
# value saved in the Settings UI, when present, wins). Accepts 1/true/yes/on
# and 0/false/no/off; unset derives from ZIPTASK_BASE_URL being configured.
# ZIPTASK_ENABLED=0

# opencode web server base URL (SSE event bus for permission asks/replies).
OPENCODE_BASE_URL=http://127.0.0.1:1234
