# shellcheck shell=bash
# ════════════════════════════════════════════════════════════════════════════
#  app.env — subagentix service configuration
#
#  Vendored framework, this app's values. Sourced by every script in deploy/,
#  so it is the single source of truth for the install.
#
#  Provenance:
#    * keys/values from ADR
#      /mnt/external/zum/ai-workdir/synaptomind/plans/2026-10-01-unify-deploy-framework-adr.md
#      §5 "app.env for subagentix (exact keys B fills)", tracker #1111.
#    * framework vendored from the synaptomind repo (github zumik3-del/synaptomind)
#      deploy/ at commit 1a3a0d6df2a78fb67b762377ab887def2e2c5d6d, itself vendored from
#      https://forgejo.home.lan/authelia/bun-templates commit 89be318daf8adab5ddca957162b3b7df8429e725.
#      Re-vendor by copying deploy/ over deploy/ and re-applying the two app-local diffs
#      recorded in the provenance headers of install.sh and updater.sh.
# ════════════════════════════════════════════════════════════════════════════

# ── Identity ───────────────────────────────────────────────────────────────
APP_NAME="subagentix"
APP_DESC="subagentix — opencode turn retrospective (Gantt) viewer"

# ── Distribution ───────────────────────────────────────────────────────────
# "source" — a git checkout that is BUILT on the host. This is the documented
# exception to the binary layout the other two apps use (ADR §5, "Deferral of
# variant C"): SvelteKit's adapter-node build emits build/index.js plus
# build/client, and compiling that with `bun build --compile` is not a shape
# anyone has verified here. The consequence is that the host needs bun and a
# toolchain at update time, and that an update is a build, not a file swap.
DIST="source"

# ── source mode ────────────────────────────────────────────────────────────
# Still REQUIRED in both modes: the frozen updater.sh bootstrap shallow-clones
# the chosen tag to stage that release's own deploy/update.sh.
REPO_URL="https://github.com/zumik3-del/subagentix.git"
# stable | latest | prerelease select a release tag; any other value is treated as
# a branch name. NOTE: this repository has no tags yet, so `stable` resolves to
# nothing and resolve_source_ref() falls back to the default branch — an install
# checks out `main`, not a pinned release. That is the safe default for an
# untagged repo, but it also means the tag path of the framework is untested for
# this app until the first tag exists.
CHECKOUT_POLICY="stable"

# ── Paths ──────────────────────────────────────────────────────────────────
INSTALL_DIR="/opt/subagentix"
DATA_DIR="/var/lib/subagentix"
RUN_DIR=""                                     # -> ${HOME}/.subagentix

# ── First-run seeding ──────────────────────────────────────────────────────
# Copied only when the destination does NOT exist, so an installed host keeps
# its own file. The live configuration is /etc/subagentix/subagentix.env (see
# UNIT_ENV_FILE below); this only gives a fresh checkout a readable .env.
SEED_FILES=".env.example:.env"
GENERATE_SECRET_IN=""                          # nothing to generate

# ── Runtime / service ──────────────────────────────────────────────────────
SERVICE_USER="opencode"
# Explicit rather than left to default_exec_start(): the default renders
# `${BUN_BIN} run start`, which resolves correctly today, but it would resolve
# against whatever bun the OPERATOR's shell has. This form pins the same absolute
# path the live unit uses, so systemd cannot start a different bun than the one
# the install was verified with (ADR §5).
EXEC_START="/usr/local/bin/bun /opt/subagentix/build/index.js"
PORT="3010"
# /api, not /health — the app's route is src/routes/api/health/+server.ts.
HEALTH_URL="http://127.0.0.1:3010/api/health"
HEALTH_TIMEOUT="60"
HEALTH_CONFIRM_TIMEOUT="30"

# ── Health contract ────────────────────────────────────────────────────────
# The body is {"ok":true,...} (healthCheck() in src/lib/server/db.ts): there is
# no `status` key and no `version` key, so the framework's defaults
# (status/version, ok|degraded) would report a contract violation on a perfectly
# healthy service and abort every install and update.
HEALTH_STATUS_FIELD="ok"
HEALTH_OK_VALUES="true"
# Empty = the version check is DISABLED (and one warning says so). The body
# carries no version, so there is nothing to compare against the checkout's
# package.json. Accepted consequence: the gate cannot tell subagentix from any
# other process answering that port — the cutover plan must not read a green
# health check as proof the right app is listening.
HEALTH_VERSION_FIELD=""

# ── Unit extras (each rendered only when non-empty) ────────────────────────
# All three are load-bearing, not cosmetic:
#   * StateDirectory= makes systemd create /var/lib/subagentix OWNED User:Group
#     and export STATE_DIRECTORY, which is what settingsFilePath()
#     (src/lib/server/settings.ts) resolves before its cwd()/.data fallback. With
#     ProtectSystem=strict and WorkingDirectory=/opt/subagentix, a settings WRITE
#     would fail at runtime — after a successful install and health check.
#   * EnvironmentFile= carries OPENCODE_DB / HOST / PORT / ZIPTASK_BASE_URL, the
#     live operator-editable config.
#   * BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 stops bun writing a transpiler cache
#     into a home directory that ProtectHome=read-only will not allow.
UNIT_STATE_DIRECTORY="subagentix"
UNIT_ENV_FILE="/etc/subagentix/subagentix.env"
UNIT_EXTRA_ENV="BUN_RUNTIME_TRANSPILER_CACHE_PATH=0"

# ── source mode: dependencies & build ─────────────────────────────────────
# NO --production: every build dependency (adapter-node, svelte, vite,
# typescript, svelte-check) is a devDependency, and --production prunes exactly
# those, so the build could not run at all.
INSTALL_FLAGS="--frozen-lockfile"
# The SvelteKit build. Without it there is no build/index.js and ExecStart
# points at a file that does not exist.
BUILD_CMD="bun run build"
BUILD_TIMEOUT="600"

# ── host requirements ──────────────────────────────────────────────────────
REQUIRES_BUN="yes"
# "git" — the checkout and the updater bootstrap. No tar (that is the DIST=binary
# payload extractor) and no sqlite3: subagentix writes NO database. It reads the
# opencode database strictly read-only and its only state is settings.json.
SYSTEM_DEP_CMDS="git"
# Empty -> ${RUN_DIR}/hooks. Both hooks ship and both are honest no-ops: the
# source-mode rollback point is a git ref (PREV_REF), the update swaps a checkout
# and never touches DATA_DIR, and subagentix writes no database — so there is
# nothing for a pre-update backup hook to back up. hooks/pre-update says so on
# every run instead of leaving install.sh warning about a missing hook.
HOOKS_DIR=""
# The piped form's helper URL. Must be THIS repository: install.sh derives both
# LIB_RAW_URL and APP_ENV_URL from it, so a foreign base would install the other
# app's configuration under this app's name.
LIB_RAW_URL="https://raw.githubusercontent.com/zumik3-del/subagentix/main/deploy/lib/common.sh"